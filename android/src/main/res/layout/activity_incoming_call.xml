<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/nativecall_background"
    android:orientation="vertical"
    android:gravity="center_horizontal"
    android:paddingTop="96dp"
    android:paddingBottom="64dp"
    android:paddingStart="32dp"
    android:paddingEnd="32dp">

    <TextView
        android:id="@+id/nativecall_eyebrow"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/nativecall_eyebrow"
        android:textAllCaps="true"
        android:textColor="@color/nativecall_accent"
        android:textSize="12sp"
        android:textStyle="bold"
        android:letterSpacing="0.15"
        android:gravity="center" />

    <TextView
        android:id="@+id/nativecall_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:textColor="@color/nativecall_text_primary"
        android:textSize="28sp"
        android:textStyle="bold"
        android:gravity="center"
        tools:text="Front Gate" />

    <TextView
        android:id="@+id/nativecall_body"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:textColor="@color/nativecall_text_secondary"
        android:textSize="16sp"
        android:gravity="center"
        tools:text="Visitor calling" />

    <Space
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_weight="1" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">

        <Button
            android:id="@+id/nativecall_decline_button"
            android:layout_width="0dp"
            android:layout_height="60dp"
            android:layout_weight="1"
            android:layout_marginEnd="20dp"
            android:background="@drawable/nativecall_button_decline_bg"
            android:stateListAnimator="@null"
            android:elevation="0dp"
            android:text="@string/nativecall_decline"
            android:textAllCaps="false"
            android:textSize="17sp"
            android:textStyle="bold"
            android:textColor="@color/nativecall_text_primary" />

        <Button
            android:id="@+id/nativecall_accept_button"
            android:layout_width="0dp"
            android:layout_height="60dp"
            android:layout_weight="1"
            android:layout_marginStart="20dp"
            android:background="@drawable/nativecall_button_accept_bg"
            android:stateListAnimator="@null"
            android:elevation="0dp"
            android:text="@string/nativecall_accept"
            android:textAllCaps="false"
            android:textSize="17sp"
            android:textStyle="bold"
            android:textColor="@color/nativecall_text_primary" />

    </LinearLayout>

</LinearLayout>
