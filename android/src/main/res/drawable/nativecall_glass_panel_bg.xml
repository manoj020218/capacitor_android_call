<?xml version="1.0" encoding="utf-8"?>
<shape xmlns:android="http://schemas.android.com/apk/res/android" android:shape="rectangle">
    <corners android:radius="20dp" />
    <!-- Mirrors glassTheme.jsx's glass.panelAccent:
         linear-gradient(155deg, rgba(91,91,255,0.16), rgba(26,26,232,0.05)) -->
    <!-- android:angle must be a multiple of 45; 315 = top-left to bottom-right,
         the closest fit to the web recipe's 155deg (CSS and Android angles are
         measured differently). -->
    <gradient
        android:angle="315"
        android:startColor="#295B5BFF"
        android:endColor="#0D1A1AE8" />
    <!-- rgba(125,139,255,0.28) -->
    <stroke android:width="1dp" android:color="#477D8BFF" />
</shape>
